# LLM
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aria
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Override for EU region: https://eu.api.smith.langchain.com

# LLM behaviour
LLM_MODE=mock                # mock | live
SONNET_MODEL=claude-sonnet-4-6
HAIKU_MODEL=claude-haiku-4-5-20251001
OPUS_MODEL=claude-opus-4-7

# Database
DATABASE_URL=postgresql+asyncpg://aria:aria@localhost:5432/aria
# For tests / local dev without Postgres, override with:
# DATABASE_URL=sqlite+aiosqlite:///./aria.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ariaadmin
S3_SECRET_KEY=ariaadmin
S3_BUCKET=aria-documents
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900
# AES256 for AWS S3 only; leave unset for Docker MinIO (SSE/KMS not configured by default)
# S3_SERVER_SIDE_ENCRYPTION=AES256

# FX providers
EXCHANGERATE_API_KEY=
OPENEXCHANGERATES_APP_ID=
FX_CACHE_TTL_SECONDS=3600

# Reconciliation tuning
BASE_CURRENCY=MYR
FX_VARIANCE_BUFFER_PCT=0.015
MATCH_CONFIDENCE_THRESHOLD=0.75
EXTRACTION_ESCALATION_THRESHOLD=0.5
DATE_WINDOW_DAYS=5

# Webhooks
# Stable 32+ char secret for encrypting webhook signing secrets at rest.
# CRITICAL: set this once and never change it — rotating this key breaks all existing webhooks.
# If unset, falls back to JWT_SECRET_KEY (dangerous if JWT key is ever rotated).
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_BASE_SECONDS=5

# Ingestion auto-batching (Celery Beat)
BATCH_SIZE_THRESHOLD=50
BATCH_TIME_WINDOW_MINUTES=15
CELERY_BEAT_INTERVAL_MINUTES=2

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aria.local
SMTP_USE_TLS=true
NOTIFICATION_EMAIL_ENABLED=false

# Auth / multi-tenancy
# Bootstrap key for admin endpoints (/api/v1/tenants). Also readable from repo-root .env.
ADMIN_API_KEY=aria-dev-admin

# JWT credential auth (used by the three frontend apps)
JWT_SECRET_KEY=aria-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Auto-seed platform admin on first startup (leave password empty to disable)
DEFAULT_ADMIN_EMAIL=admin@aria.local
DEFAULT_ADMIN_PASSWORD=

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
