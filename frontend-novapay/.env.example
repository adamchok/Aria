VITE_API_BASE_URL=
# When running via Vite's dev proxy you can leave VITE_API_BASE_URL empty
# and requests to /api will be forwarded to VITE_API_PROXY_TARGET below.
VITE_API_PROXY_TARGET=http://localhost:8000
# API key issued via the ARIA tenant management portal (Settings > API Keys).
# Used as the X-API-Key header on all backend requests.
VITE_API_KEY=
