# Docker Compose environment — copy to .env at the repository root:
#   cp .env.example .env
#
# Compose loads this file automatically for ${VAR} substitution in
# docker-compose.yml. Infra URLs (Postgres, Redis, MinIO) are set in the
# compose file; you only need to configure LLM behaviour here.
#
# Without a .env file, LLM_MODE defaults to mock and the stack runs
# end-to-end with deterministic fixture responses.

# Anthropic — required when LLM_MODE=live
ANTHROPIC_API_KEY=

# mock = fixture responses (default) | live = real Claude API calls
LLM_MODE=mock
