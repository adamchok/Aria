# Docker Compose environment — copy to .env at the repository root:
#   cp .env.example .env
#
# Compose loads this file automatically for ${VAR} substitution in
# docker-compose.yml. Without a .env file, LLM_MODE defaults to mock and
# the stack runs end-to-end with deterministic fixture responses.

# ── LLM ─────────────────────────────────────────────────────────────────────

# Anthropic — required when LLM_MODE=live
ANTHROPIC_API_KEY=

# mock = fixture responses (default) | live = real Claude API calls
LLM_MODE=mock

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aria
LANGSMITH_TRACING=false
# Override for EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Model overrides (optional — defaults match backend/.env.example)
# SONNET_MODEL=claude-sonnet-4-6
# HAIKU_MODEL=claude-haiku-4-5-20251001
# OPUS_MODEL=claude-opus-4-7

# ── Auth ─────────────────────────────────────────────────────────────────────

# Admin bootstrap key for tenant/key management endpoints (/api/v1/tenants)
# Change this in production. In dev the default "aria-dev-admin" is used.
ADMIN_API_KEY=aria-dev-admin

# JWT credential auth (Admin + Tenant mgmt UIs)
JWT_SECRET_KEY=aria-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_EMAIL=admin@aria.local
DEFAULT_ADMIN_PASSWORD=

# ── NovaPay (reference client) ─────────────────────────────────────────────

# Tenant API key baked into the NovaPay Docker image at build time.
# Create a key in Tenant mgmt → Keys after first login, add it here, then:
#   docker compose up --build frontend-novapay
# Or set before the initial full-stack build. Leave empty to use Admin/Tenant
# mgmt UIs only (NovaPay API calls return 401 until this is set and rebuilt).
VITE_API_KEY=

# ── Ingestion pipeline ───────────────────────────────────────────────────────

# Auto-batch: create a job when buffer hits N transactions
BATCH_SIZE_THRESHOLD=50

# Auto-batch: create a job when oldest buffered transaction is ≥ N minutes old
BATCH_TIME_WINDOW_MINUTES=15

# How often Celery Beat checks the buffer (minutes)
CELERY_BEAT_INTERVAL_MINUTES=2

# Max parallel LLM calls during proof extraction (keep ≤5 to avoid 429s)
INGESTION_CONCURRENCY=3
# Per-document retries on rate-limit (429) before failing (legacy; live mode uses LLM_MAX_RETRIES)
INGESTION_MAX_RETRIES=3

# Max parallel LLM calls during match reasoning (keep ≤5 to avoid 429s)
MATCHING_CONCURRENCY=3

# Central Anthropic 429 retries for all pipeline LLM calls
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_SECONDS=2.0
LLM_RETRY_TPM_BASE_SECONDS=30.0

# ── Webhooks ─────────────────────────────────────────────────────────────────

WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BACKOFF_BASE_SECONDS=5
WEBHOOK_MIN_INTERVAL_SECONDS=1.5
WEBHOOK_RATE_LIMIT_BACKOFF_SECONDS=60
# Stable 32+ char secret for encrypting webhook signing secrets at rest.
# If unset, falls back to JWT_SECRET_KEY (avoid rotating JWT if webhooks exist).
WEBHOOK_SECRET_ENCRYPTION_KEY=

# ── FX ───────────────────────────────────────────────────────────────────────

EXCHANGERATE_API_KEY=
OPENEXCHANGERATES_APP_ID=
# FX_CACHE_TTL_SECONDS=3600

# ── Reconciliation tuning (optional — defaults shown) ────────────────────────

# BASE_CURRENCY=MYR
# FX_VARIANCE_BUFFER_PCT=0.015
# MATCH_CONFIDENCE_THRESHOLD=0.75
# EXTRACTION_ESCALATION_THRESHOLD=0.5
# DATE_WINDOW_DAYS=5

# ── App ──────────────────────────────────────────────────────────────────────

# APP_ENV=development
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
